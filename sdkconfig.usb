# USB configuration for ESP32-S3 Vision - DISABLED (use UART REPL)
# ESP32-S3 has native USB OTG, but MicroPython TinyUSB CDC integration
# requires resolving linker circular dependency (tinyusb <-> main callbacks).
# Use UART REPL for now - works reliably via UART0 (GPIO43/44).
CONFIG_USB_CDC_BOOT_DEFAULT=n
CONFIG_USB_CDC_ENABLED=n
CONFIG_USB_OTG_SUPPORTED=n
CONFIG_TINYUSB_ENABLED=n